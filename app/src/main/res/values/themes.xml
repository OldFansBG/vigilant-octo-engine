<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints everything; this only needs to avoid a jarring flash before the
         first frame and to keep the system bars out of the way. -->
    <style name="Theme.T212Widgets" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
